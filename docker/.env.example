# Exemple de configuration pour le déploiement Docker
# Copiez ce fichier en .env et adaptez les valeurs

# URL publique du serveur (obligatoire pour Caddy en HTTPS)
HS_SERVER_URL=https://hs.mondomaine.com

# Port HTTP interne (ne changez que si vous modifiez le docker-compose.yml)
HS_PORT=8080

# Utilisateur administrateur initial
HS_USER=admin

# Domaine interne pour le DNS magique
HS_BASE_DOMAIN=headscale.internal

# Serveurs DNS
HS_DNS1=1.1.1.1
HS_DNS2=1.0.0.1

# Niveau de log (debug, info, warn, error)
HS_LOG_LEVEL=info

# Port pour les métriques Prometheus
HS_METRICS_PORT=9090
