{
  "groups": {
    "group:admins": ["admin@headscale.internal"]
  },
  "tagOwners": {
    "tag:gateway": ["group:admins"],
    "tag:exit-node": ["group:admins"]
  },
  "hosts": {},
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"]
    }
  ],
  "tests": [],
  "autoApprovers": {
    "exitNode": ["tag:exit-node"],
    "routes": {
      "0.0.0.0/0": ["tag:gateway"],
      "::/0": ["tag:gateway"]
    }
  },
  "randomizeClientPort": false
}
